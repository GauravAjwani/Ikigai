# Copy to .env and fill in. Replay UI needs only GEMINI_API_KEY.
# Slack tokens are optional — leave them empty to use the fixture workspace.

# Gemini Developer API (local / Cloud Run without ADC)
GEMINI_API_KEY=

# Vertex AI on GCP (preferred in production)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
IKIGAI_VERTEX=false

# Slack — required for a real workspace agent (Socket Mode locally)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# Optional user token (xoxp-) so search.messages works; otherwise we scan
# channels the bot is in via conversations.history
SLACK_USER_TOKEN=

# Cost kill switch
DAILY_BUDGET_USD=10
HARD_BUDGET_USD=40

# Optional. On Cloud Run, /api/* (except /api/health) and /mcp/* stay locked
# unless this is set and sent as header X-Ikigai-Token.
IKIGAI_API_TOKEN=
