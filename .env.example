# Gemini Developer API (local / Cloud Run without ADC)
GEMINI_API_KEY=

# Vertex AI on GCP (preferred in production)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
PRECEDENT_VERTEX=false

# Optional Slack (HTTP events → the same Cloud Run service)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Cost kill switch
DAILY_BUDGET_USD=10
HARD_BUDGET_USD=40
